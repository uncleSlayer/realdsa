---
import BaseLayout from '../layouts/BaseLayout.astro';
import { topics } from '../data/topics';
import { url } from '../lib/url';
---

<BaseLayout
  title="RealDSA: interactive data structure labs"
  description="Interactive labs for learning data structures and algorithms. Pick an operation, step through the code line by line, and watch the structure change."
>
  <div class="wrap">
    <header class="home-head">
      <p class="eyebrow">Interactive DSA labs</p>
      <h1>Learn data structures by watching them change.</h1>
      <p class="lede">
        Each lab runs real code one line at a time and draws exactly what that line does to memory: which
        pointer moves, which node is created, what becomes garbage.
      </p>
    </header>

    <section class="topics" aria-label="Topics">
      <h2>Topics</h2>
      <ol class="topic-grid">
        {
          topics.map((t, i) => (
            <li>
              <a class="topic-card" href={url(`/topics/${t.slug}/`)}>
                <span class="topic-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="topic-title">{t.title}</span>
                <span class="topic-sum">{t.summary}</span>
                <span class="topic-tags">
                  <span class="topic-lang">{t.language}</span>
                  {t.tags.map((tag) => (
                    <span>{tag}</span>
                  ))}
                </span>
                <span class="topic-go">Open lab →</span>
              </a>
            </li>
          ))
        }
        <li class="topic-soon" aria-label="More topics coming">
          <span class="topic-num">{String(topics.length + 1).padStart(2, '0')}</span>
          <span>More topics on the way.</span>
        </li>
      </ol>
    </section>
  </div>
</BaseLayout>

<style>
  .home-head {
    display: grid;
    gap: 14px;
  }
  .home-head h1 {
    max-width: 18ch;
  }
  .topics {
    display: grid;
    gap: 14px;
  }
  .topic-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 16px;
  }
  .topic-card {
    height: 100%;
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 18px 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    color: var(--fg);
    text-decoration: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .topic-card:hover {
    border-color: var(--hl);
    box-shadow: inset 0 0 0 1px var(--hl);
  }
  .topic-num {
    font: 600 0.74rem var(--mono);
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .topic-title {
    font: 600 1.35rem/1.15 var(--display);
  }
  .topic-sum {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .topic-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .topic-tags span {
    font: 400 0.74rem var(--mono);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 1px 7px;
  }
  .topic-tags .topic-lang {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--bg);
    font-weight: 600;
  }
  .topic-go {
    font: 600 0.9rem var(--body);
    color: var(--ptr);
    margin-top: 4px;
  }
  .topic-soon {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 18px 20px;
    border: 1px dashed var(--line);
    border-radius: 12px;
    color: var(--muted);
  }
</style>
